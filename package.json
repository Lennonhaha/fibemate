    "bcryptjs": "3.0.3",
    "better-sqlite3": "13.0.3",
    "cors": "2.8.6",
    "express": "^5.1.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "lowdb": "7.0.1",
    "mongoose": "9.7.2",
    "node-addon-api": "8.9.2",
    "pqc-kyber": "0.7.0",
