{
  "name": "fibemate-www",
  "version": "2.0.0",
  "description": "FIBEMATE static site. Production is nginx; npm start serves this tree read-only for local preview.",
  "private": true,
  "scripts": {
    "start": "node ../scripts/preview-site.cjs --root .",
    "dev": "node ../scripts/preview-site.cjs --root .",
    "check": "node ../scripts/preview-site.cjs --root . --selftest"
  },
  "dependencies": {
    "@noble/hashes": "2.2.0",
    "@noble/post-quantum": "0.6.1",
    "cors": "2.8.5",
    "express": "4.22.3",
    "snarkjs": "0.7.6",
    "ws": "^8.21.0"
  },
  "overrides": {
    "underscore": "1.13.8",
    "qs": "6.16.1",
    "proxy-addr": "2.0.8"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
