{
  "name": "fibemate-e2e-tests",
  "version": "1.0.0",
  "description": "FIBEMATE End-to-End Test Suite",
  "scripts": {
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "test:auth": "cypress run --spec 'cypress/e2e/auth.spec.js'",
    "test:messaging": "cypress run --spec 'cypress/e2e/messaging.spec.js'",
