<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FIBEMATE - 隐私增强即时通讯</title>
  <link rel="stylesheet" href="main.css">
  <script src="double-ratchet.js" defer></script>
  <script src="message-crypto-v2.js" defer></script>
  <!-- Post-Quantum WASM: ML-KEM-768 hybrid key exchange -->
  <!-- DISABLED: use ml-kem-768-wrapper.js (backend API) instead -->
<!--<script type="module">
    // Import WASM module with correct function names from Rust bindings
    // 注意：实际路径为 crypto/crypto/pq-wasm/pkg/（WASM 构建输出目录）
    import init, { generateKeypair, encapsulate, decapsulate } from './crypto/crypto/pq-wasm/pkg/fibemate_pq_wasm.js';
    
    // Initialize WASM module
    async function initPQWASM() {
      try {
        console.log('[PQ-WASM] Initializing ML-KEM-768 WASM module...');
        await init();
        
        // Verify functions are available
        if (typeof generateKeypair !== 'function') {
          throw new Error('generateKeypair not exported from WASM');
        }
        if (typeof encapsulate !== 'function') {
          throw new Error('encapsulate not exported from WASM');
        }
        if (typeof decapsulate !== 'function') {
          throw new Error('decapsulate not exported from WASM');
        }
        
        // Wrap WASM functions to return consistent interface
        window.MLKEM768 = {
          keygen: async () => {
            const kp = generateKeypair();
            return {
              public_key: kp.public_key,
              secret_key: kp.secret_key
            };
          },
          encaps: async (publicKey) => {
            const ct = encapsulate(publicKey);
            return {
              ciphertext: ct.ciphertext,
              shared_secret: ct.shared_secret
            };
          },
          decaps: async (secretKey, ciphertext) => {
            return decapsulate(secretKey, ciphertext);
          },
          initialized: true,
          _raw: { generateKeypair, encapsulate, decapsulate }
        };
        
        console.log('[PQ-WASM] ML-KEM-768 initialized successfully ✓');
        
        // Dispatch event for listeners
        window.dispatchEvent(new CustomEvent('pq-wasm-ready', { detail: { available: true } }));
        
      } catch (err) {
        console.warn('[PQ-WASM] Initialization failed:', err.message);
        window.MLKEM768 = { initialized: false, error: err.message };
        window.dispatchEvent(new CustomEvent('pq-wasm-ready', { detail: { available: false, error: err.message } }));
      }
    }
    
    // Initialize immediately
    initPQWASM();
  </script>-->
  <!-- PQ Integration Module -->
  <script src="crypto/crypto/pq-integration.js"></script>
  <script src="api/privacy-api-client.js" type="module"></script>
  <script src="privacy-layers/index.js" type="module"></script>
  <script src="privacy-integration.js" type="module"></script>
  <!-- PQ-WASM Test Suite (development only) -->
  <script src="crypto/crypto/pq-test-electron.js" defer></script>
  <!-- FIBEMATE Modular Architecture (refactored from main-v3.js) -->
  <script src="WSManager.js"></script>
  <script src="modules/app-state.js"></script>
  <script src="modules/utils.js"></script>
  <script src="modules/navigation.js"></script>
  <script src="modules/websocket.js"></script>
  <script src="modules/conversations.js"></script>
  <script src="modules/chat.js"></script>
  <script src="modules/contacts.js"></script>
  <script src="modules/vault.js"></script>
  <script src="modules/keys.js"></script>
  <script src="modules/settings.js"></script>
  <script src="modules/calls.js"></script>
  <script src="modules/privacy.js"></script>
  <script src="modules/backend.js"></script>
  <!-- Phone Verification (must load before main.js) -->
  <script src="phone-verify.js" defer></script>
  <script src="main.js" defer></script>
  <script src="features-enhancement.js" defer></script>
  <script src="performance-optimization.js" defer></script>
  <script src="webrtc-module.js" defer></script>
  <script src="video-call-ui.js" defer></script>
  <!-- ZK Modules -->
  <script src="zk/zk-browser.js" defer></script>
  <!-- v1 disabled, using v2 (correct EC point operations) -->
  <!-- <script src="zk/schnorr-prover.js" defer></script> -->
  <script src="zk/schnorr-prover-v2.js" defer></script>
  <!-- <script src="zk/schnorr-verifier.js" defer></script> -->
  <script src="zk/bulletproofs.js" defer></script>
  <script src="zk/zk-auth.js" defer></script>
  <script src="zk/zk-integration.js" defer></script>
  <script src="zk-ui-integration.js" defer></script>
  <script src="user-levels.js" defer></script>
  <!-- Voice Message -->
  <script src="modules/voice-message.js" defer></script>
  <!-- E2EE Status Display -->
  <script src="modules/e2ee-display.js" defer></script>
  <!-- Mobile Adaptation -->
  <script src="modules/mobile-adapt.js" defer></script>
  <!-- Two-Factor Auth -->
  <script src="modules/two-factor-auth.js" defer></script>
  <!-- Message Recall -->
  <script src="modules/message-recall.js" defer></script>
  <!-- Read Receipts -->
  <script src="modules/read-receipts.js" defer></script>
  <!-- Satellite Network Adaptation -->
  <script src="modules/satellite/network-detector.js" defer></script>
  <script src="modules/satellite/satellite-mode.js" defer></script>
  <script src="modules/satellite/fec.js" defer></script>
  <script src="modules/satellite/rapid-reconnect.js" defer></script>
  <script src="modules/satellite/satellite-integration.js" defer></script>
  
  <!-- Quantum City Network -->
  <script src="modules/quantum/quantum-adapter.js" defer></script>
  <script src="modules/quantum/quantum-crypto.js" defer></script>
  <script src="modules/quantum/quantum-integration.js" defer></script>
  
  <!-- 5G-A Network -->
  <script src="modules/5g-a/5g-a-adapter.js" defer></script>
  <script src="modules/5g-a/5g-a-optimization.js" defer></script>
  <script src="modules/5g-a/5g-a-integration.js" defer></script>
  <!-- 简洁背景 -->
  <style>
    /* 纯色背景 */
    body {
      background: var(--bg-primary);
    }
    /* 内容层 */
    .app-container {
      position: relative;
      z-index: 1;
    }
  </style>
</head>
<body>
  <div class="app-container">

    <!-- ============================================ -->
    <!-- 侧边栏 -->
    <!-- ============================================ -->
    <aside class="sidebar" id="sidebar">

      <!-- 品牌头部 -->
      <div class="sidebar-header">
        <div class="shield-icon">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M12 2L20 6V11C20 16 16 20 12 22C8 20 4 16 4 11V6L12 2Z"
                  stroke="currentColor" stroke-width="1.5" fill="none"/>
          </svg>
        </div>
        <h2 class="sidebar-title">FIBEMATE</h2>
      </div>

      <!-- 导航标签页 -->
      <nav class="sidebar-nav">
        <button class="nav-tab active" data-tab="messages" title="Messages">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          </svg>
          <span>Messages</span>
        </button>
        <button class="nav-tab" data-tab="contacts" title="Contacts">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
          <span>Contacts</span>
        </button>
        <button class="nav-tab" data-tab="vault" title="Vault">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
          <span>Vault</span>
        </button>
        <button class="nav-tab" data-tab="keys" title="Keys">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>
          </svg>
          <span>Keys</span>
        </button>
        <button class="nav-tab" data-tab="settings" title="Settings">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="3"/>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
          </svg>
          <span>Settings</span>
        </button>
      </nav>

      <!-- 搜索栏 -->
      <div class="search-bar">
        <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
        </svg>
        <input type="text" id="searchInput"
          autocomplete="off"
          autocorrect="off"
          spellcheck="false"
          autocapitalize="off"
          data-lpignore="true"
          data-form-type="other"
          name="no_cache_1778955725.4432724"
          placeholder="搜索...">
      </div>

      <!-- ===== 消息列表面板 ===== -->
      <div class="tab-panel active" id="panelMessages">
        <div class="panel-header">
          <span class="panel-title">Messages</span>
          <button class="icon-btn" id="btnNewChat" title="New chat">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 5v14M5 12h14"/>
            </svg>
          </button>
        </div>
        <div class="conversation-list" id="conversationList">
          <div class="empty-state" id="emptyState">
            <svg viewBox="0 0 64 64" fill="none">
              <path d="M32 8L56 18V36C56 50 44 58 32 62C20 58 8 50 8 36V18L32 8Z"
                    stroke="currentColor" stroke-width="1.5" fill="none"/>
            </svg>
            <p>No conversations yet</p>
            <button class="btn-primary-sm" id="btnStartChat">Start a conversation</button>
          </div>
        </div>
      </div>

      <!-- ===== 联系人面板 ===== -->
      <div class="tab-panel" id="panelContacts">
        <div class="panel-header">
          <span class="panel-title">Contacts</span>
          <button class="icon-btn" id="btnAddContact" title="Add contact">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 5v14M5 12h14"/>
            </svg>
          </button>
        </div>
        <div class="contact-list" id="contactList">
          <div class="empty-state" id="emptyContacts">
            <svg viewBox="0 0 64 64" fill="none">
              <circle cx="32" cy="24" r="10" stroke="currentColor" stroke-width="1.5" fill="none"/>
              <path d="M16 52c0-9 7-16 16-16s16 7 16 16" stroke="currentColor" stroke-width="1.5" fill="none"/>
            </svg>
            <p>No contacts yet</p>
            <button class="btn-primary-sm" id="btnAddContactEmpty">Add a contact</button>
          </div>
        </div>
      </div>

      <!-- ===== 保险库面板 ===== -->
      <div class="tab-panel" id="panelVault">
        <div class="panel-header">
          <span class="panel-title">Vault</span>
          <button class="icon-btn" id="btnUploadVault" title="Upload file">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/>
            </svg>
          </button>
        </div>
        <div class="vault-list" id="vaultList">
          <div class="empty-state" id="emptyVault">
            <svg viewBox="0 0 64 64" fill="none">
              <rect x="12" y="24" width="40" height="32" rx="4" stroke="currentColor" stroke-width="1.5" fill="none"/>
              <path d="M12 32h40" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="32" cy="42" r="4" stroke="currentColor" stroke-width="1.5" fill="none"/>
            </svg>
            <p>Vault is empty</p>
            <button class="btn-primary-sm" id="btnUploadVaultEmpty">Upload a file</button>
          </div>
        </div>
      </div>

      <!-- ===== 密钥管理面板 ===== -->
      <div class="tab-panel" id="panelKeys">
        <div class="panel-header">
          <span class="panel-title">Key Management</span>
        </div>
        <div class="key-list" id="keyList">
          <!-- 密钥信息卡片 -->
        </div>
      </div>

      <!-- ===== 设置面板 ===== -->
      <div class="tab-panel" id="panelSettings">
        <div class="panel-header">
          <span class="panel-title">Settings</span>
        </div>
        <div class="settings-list" id="settingsList">
          <!-- 设置项 -->
        </div>
      </div>

      <!-- 连接状态指示器 -->
      <div class="connection-status" id="connectionStatus">
        <span class="connection-dot" id="connectionDot"></span>
        <span id="connectionText">连接中...</span>
      </div>

      <!-- 用户信息栏 -->
      <div class="user-bar" id="userBar">
        <div class="user-avatar" id="userAvatar">U</div>
        <div class="user-info">
          <div class="user-name" id="userName">User</div>
          <div class="user-status">
            <span class="status-dot online"></span>
            <span>Online</span>
          </div>
        </div>
        <button class="btn-exit" id="btnLogout" onclick="if(confirm('退出登录？')){localStorage.removeItem('fk_token');localStorage.removeItem('fk_uname');localStorage.removeItem('fk_uid');localStorage.removeItem('fk_displayName');window.location.href='login.html';}">退出登录</button>
      </div>
    </aside>

    <!-- ============================================ -->
    <!-- 主内容区 -->
    <!-- ============================================ -->
    <main class="chat-area" id="chatArea">

      <!-- ===== 聊天视图 ===== -->
      <div class="chat-empty" id="chatEmpty">
        <div class="hex-glow">
          <svg viewBox="0 0 64 72" fill="none">
            <path d="M32 4L58 14V36C58 50 48 60 32 66C16 60 6 50 6 36V14L32 4Z"
                  stroke="currentColor" stroke-width="1.5" fill="none"/>
          </svg>
        </div>
        <h3>Select a conversation</h3>
        <p>Choose from your existing conversations or start a new one</p>
      </div>

      <div class="chat-window" id="chatWindow" style="display:none">
        <div class="chat-header">
          <!-- 移动端菜单按钮 -->
          <button class="icon-btn" id="btnMenuToggle" title="Menu" style="display:none">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 12h18M3 6h18M3 18h18"/>
            </svg>
          </button>
          <button class="icon-btn" id="btnBack" title="Back">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 12H5M12 5l-7 7 7 7"/>
            </svg>
          </button>
          <div class="chat-peer-info" id="chatPeerInfo">
            <div class="chat-peer-avatar" id="chatPeerAvatar">?</div>
            <div class="chat-peer-details">
              <div class="chat-peer-name" id="chatPeerName">Peer</div>
              <div class="chat-peer-status" id="chatPeerStatus">Encrypted</div>
              <!-- 加密状态指示器 -->
              <div class="e2ee-status-bar" id="e2eeStatusBar" style="display:none">
                <span class="e2ee-status-icon" id="e2eeStatusIcon">🔒</span>
                <span class="e2ee-status-text" id="e2eeStatusText">E2EE</span>
                <span class="e2ee-status-detail" id="e2eeStatusDetail"></span>
              </div>
            </div>
          </div>
          <div class="chat-header-actions">
            <button class="icon-btn" id="btnVoiceCall" title="Voice call">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
            </button>
            <button class="icon-btn" id="btnVideoCall" title="Video call">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="23 7 16 12 23 17 23 7"/>
                <rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>
              </svg>
            </button>
            <button class="icon-btn" id="btnVerify" title="Verify keys">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
            </button>
          </div>
        </div>

        <div class="messages-list" id="messagesList"></div>

        <div class="chat-input-bar">
          <button class="icon-btn" id="btnAttach" title="Attach file">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
            </svg>
          </button>
          <button class="icon-btn" id="btnBurn" title="Burn after read">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>
            </svg>
          </button>
          <input type="text" id="messageInput" placeholder="Type a message..." autocomplete="off" spellcheck="false">
          <button class="icon-btn send-btn" id="btnSend" title="Send">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- ===== 语音通话视图 ===== -->
      <div class="call-view" id="callView" style="display:none">
        <div class="call-avatar" id="callAvatar">?</div>
        <div class="call-name" id="callName">Unknown</div>
        <div class="call-status" id="callStatus">Calling...</div>
        <div class="call-timer" id="callTimer">00:00</div>
        <div class="call-actions">
          <button class="call-btn" id="btnMute" title="Mute">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
              <path d="M19 10v2a7 7 0 0 1-14 0v-2M12 19v4M8 23h8"/>
            </svg>
          </button>
          <button class="call-btn hangup" id="btnHangup" title="Hang up">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M10.68 13.31a16 16 0 0 0 3.41 2.6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11l-1.27 1.27"/>
            </svg>
          </button>
          <button class="call-btn" id="btnSpeaker" title="Speaker">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
              <path d="M15.54 8.46a5 5 0 0 1 0 7.07M19.07 4.93a10 10 0 0 1 0 14.14"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- ===== 密钥详情视图 ===== -->
      <div class="key-detail-view" id="keyDetailView" style="display:none">
        <div class="key-detail-header">
          <h3>Key Management</h3>
          <p>Manage your encryption keys and security settings</p>
        </div>
        <div class="key-cards" id="keyCards"></div>
        <div class="key-actions">
          <button class="btn-primary" id="btnRotateKeys">Rotate All Keys</button>
          <button class="btn-secondary" id="btnExportKeys">Export Public Keys</button>
        </div>
      </div>

      <!-- ===== 设置详情视图 ===== -->
      <div class="settings-detail-view" id="settingsDetailView" style="display:none">
        <div class="settings-detail-header">
          <h3>Settings</h3>
          <p>Customize your FIBEMATE experience</p>
        </div>
        <div class="settings-sections" id="settingsSections"></div>
      </div>

    </main>
  </div>

  <!-- ===== 模态框 ===== -->

  <!-- 添加联系人 -->
  <div class="modal-overlay" id="modalAddContact" style="display:none">
    <div class="modal">
      <div class="modal-header">
        <h4>Add Contact</h4>
        <button class="modal-close" data-modal="modalAddContact">×</button>
      </div>
      <div class="modal-body">
        <div class="input-group">
          <label>Username</label>
          <input type="text" id="contactUsername" placeholder="Enter username" autocomplete="off">
        </div>
        <div class="input-group">
          <label>Display Name (optional)</label>
          <input type="text" id="contactDisplayName" placeholder="Enter display name" autocomplete="off">
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn-secondary modal-close" data-modal="modalAddContact">Cancel</button>
        <button class="btn-primary" id="btnConfirmAddContact">Add Contact</button>
      </div>
    </div>
  </div>

  <!-- 上传文件到保险库 -->
  <div class="modal-overlay" id="modalUploadVault" style="display:none">
    <div class="modal">
      <div class="modal-header">
        <h4>Upload to Vault</h4>
        <button class="modal-close" data-modal="modalUploadVault">×</button>
      </div>
      <div class="modal-body">
        <div class="vault-dropzone" id="vaultDropzone">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/>
          </svg>
          <p>Drag files here or click to browse</p>
          <input type="file" id="vaultFileInput" multiple style="display:none">
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn-secondary modal-close" data-modal="modalUploadVault">Cancel</button>
        <button class="btn-primary" id="btnConfirmUpload">Upload</button>
      </div>
    </div>
  </div>

  <!-- Toast -->
  <div class="toast" id="toast" style="display:none"></div>

  <!-- 退出按钮逻辑 -->
  <script>
    // ================================================
    // FIBEMATE 主界面初始化
    // ================================================
    
    (function() {
      'use strict';
      
      // ---- Toast 通知系统 ----
      window.showToast = function(message, type = 'info', duration = 3000) {
        const toast = document.getElementById('toast');
        if (!toast) return;
        
        // 清除之前的隐藏类
        toast.classList.remove('hiding', 'success', 'error', 'warning', 'info');
        
        // 图标映射
        const icons = {
          success: '✅',
          error: '❌',
          warning: '⚠️',
          info: 'ℹ️'
        };
        
        toast.innerHTML = `<span>${icons[type] || ''}</span><span>${message}</span>`;
        toast.classList.add(type);
        toast.style.display = 'flex';
        
        // 自动隐藏
        if (window._toastTimer) clearTimeout(window._toastTimer);
        window._toastTimer = setTimeout(() => {
          toast.classList.add('hiding');
          setTimeout(() => {
            toast.style.display = 'none';
            toast.classList.remove('hiding');
          }, 250);
        }, duration);
      };
      
      // ---- 连接状态管理 ----
      function updateConnectionStatus(status, text) {
        const dot = document.getElementById('connectionDot');
        const textEl = document.getElementById('connectionText');
        if (!dot || !textEl) return;
        
        dot.className = 'connection-dot ' + status;
        textEl.textContent = text;
      }
      
      // 监听 WSManager 连接状态
      if (typeof WSManager !== 'undefined') {
        WSManager.on('connected', () => {
          updateConnectionStatus('online', '已连接');
          showToast('服务器连接成功', 'success');
        });
        
        WSManager.on('disconnected', () => {
          updateConnectionStatus('offline', '已断开');
          showToast('与服务器断开连接', 'warning');
        });
        
        WSManager.on('connecting', () => {
          updateConnectionStatus('connecting', '连接中...');
        });
        
        WSManager.on('error', (err) => {
          showToast('连接错误: ' + (err.message || err), 'error');
        });
      } else {
        updateConnectionStatus('offline', 'WSManager 未加载');
      }
      
      // ---- 退出登录 ----
      document.addEventListener('DOMContentLoaded', () => {
        const logoutBtn = document.getElementById('btnLogout');
        if (logoutBtn) {
          logoutBtn.addEventListener('click', (e) => {
            e.preventDefault();
            if (confirm('确定要退出登录吗？')) {
              // 断开 WebSocket
              if (typeof WSManager !== 'undefined' && WSManager.isConnected()) {
                WSManager.disconnect();
              }
              // 清除本地存储
              localStorage.removeItem('fk_token');
              localStorage.removeItem('fk_uname');
              localStorage.removeItem('fk_uid');
              localStorage.removeItem('fk_displayName');
              // 跳转到登录页
              window.location.href = 'login.html';
            }
          });
        }
        
        // 初始化连接状态
        updateConnectionStatus('connecting', '正在连接...');
        
        // 显示用户信息
        const userNameEl = document.getElementById('userName');
        const displayName = sessionStorage.getItem('fk_displayName') || localStorage.getItem('fk_uname') || 'User';
        if (userNameEl) userNameEl.textContent = displayName;
        
        // 用户头像首字母
        const avatarEl = document.getElementById('userAvatar');
        if (avatarEl && displayName) {
          avatarEl.textContent = displayName.charAt(0).toUpperCase();
        }
      });
      
      // ---- 移动端侧边栏切换 ----
      function toggleSidebar() {
        const sidebar = document.getElementById('sidebar');
        if (sidebar) sidebar.classList.toggle('hidden');
      }
      
      // 移动端菜单按钮
      document.addEventListener('DOMContentLoaded', () => {
        const menuBtn = document.getElementById('btnMenuToggle');
        const backBtn = document.getElementById('btnBack');
        
        if (menuBtn) {
          menuBtn.addEventListener('click', toggleSidebar);
        }
        
        if (backBtn) {
          backBtn.addEventListener('click', () => {
            if (window.innerWidth <= 640) toggleSidebar();
          });
        }
        
        // 点击聊天区域关闭侧边栏（移动端）
        const chatArea = document.getElementById('chatArea');
        if (chatArea) {
          chatArea.addEventListener('click', (e) => {
            if (window.innerWidth <= 640) {
              const sidebar = document.getElementById('sidebar');
              if (sidebar && !sidebar.classList.contains('hidden')) {
                toggleSidebar();
              }
            }
          });
        }
      });
      
      // 全局暴露
      window.FIBEMATE_UI = {
        showToast,
        toggleSidebar,
        updateConnectionStatus
      };
      
    })();
  </script>

  <!-- === Obscene Word Cache Cleanup (23:36) === -->
  <script>
  (function(){
    try {
      var BLOCKLIST = /初中生|初中生自愿|幼女|萝莉|未成年|小学生|儿童|强.j|轮.j|迷.j|猥.亵|色情|裸体|黄片|做.爱|自慰|手淫|乱伦|兽交|恋童|SM|调教|奴|贱|婊|妓|嫖|赌|毒|自杀|杀人|恐怖袭击|炸弹|枪支|走私|诈骗|传销|洗钱|反动|颠覆|法轮功|藏独|台独|疆独|港独|分裂|暴恐|极端|圣战|ISIS|基地组织|塔利班|黑警|支那|蝗虫|粉红|小粉红|五毛|美分|带路党/;
      var keysToRemove = [];
      for (var i = 0; i < localStorage.length; i++) {
        var key = localStorage.key(i);
        var val = localStorage.getItem(key) || '';
        if (BLOCKLIST.test(key) || BLOCKLIST.test(val)) { keysToRemove.push(key); }
      }
      keysToRemove.forEach(function(k){ localStorage.removeItem(k); });
      if (keysToRemove.length > 0) console.log('[FIBEMATE] Cleaned ' + keysToRemove.length + ' cached entries');
      var sKeys = [];
      for (var j = 0; j < sessionStorage.length; j++) {
        var sk = sessionStorage.key(j); var sv = sessionStorage.getItem(sk) || '';
        if (BLOCKLIST.test(sk) || BLOCKLIST.test(sv)) sKeys.push(sk);
      }
      sKeys.forEach(function(k){ sessionStorage.removeItem(k); });
      setTimeout(function(){
        document.querySelectorAll('datalist').forEach(function(dl){
          dl.querySelectorAll('option').forEach(function(opt){
            if (BLOCKLIST.test(opt.value||opt.label||'')) opt.remove();
          });
        });
      }, 100);
    } catch(e){ console.warn('[FIBEMATE] Cleanup error:', e.message); }
  })();
  </script>

  <script src="inp.js"></script>

<script>
// ===== Profanity Filter for Chat =====
(function() {
  const PROFANITY_LIST = [
    '操你','傻逼','草泥马','狗日','妈逼','鸡巴','操蛋','王八蛋','去你妈','日你',
    '操','肏','屄','屌','逼','靠','艹','干你','干死','搞你','贱人','碧池',
    '混蛋','废物','脑残','智障','白痴','弱智','滚蛋','滚开','去死','死人',
    '妈的','他妈','你妈','他妈的','狗屁','屁话','吃屎','屎','垃圾','恶心',
    'fuck','shit','asshole','bitch','bastard','dick','cock','cunt','pussy','whore',
    'slut','damn','crap','moron','idiot','stupid','dumbass','jackass','douche','wanker',
    'nigger','nigga','faggot','retard','skank','twat','piss','hell'
  ];
  
  const pattern = new RegExp('(' + PROFANITY_LIST.map(w => w.replace(/[.*+?^${}()|[\]\]/g, '\$&')).join('|') + ')', 'gi');
  
  window.__filterProfanity = function(text) {
    if (!text || typeof text !== 'string') return text;
    return text.replace(pattern, function(match) {
      return '*'.repeat(match.length);
    });
  };
  
  // Filter chat messages as they appear
  var observer = new MutationObserver(function(mutations) {
    mutations.forEach(function(m) {
      m.addedNodes.forEach(function(node) {
        if (node.nodeType === 3 && node.parentElement && !node.parentElement.classList.contains('profanity-checked')) {
          var filtered = window.__filterProfanity(node.textContent);
          if (filtered !== node.textContent) {
            node.textContent = filtered;
          }
        }
        if (node.nodeType === 1) { // element
          node.querySelectorAll && node.querySelectorAll('.message-text, .chat-message, .msg-content, [class*="message"]').forEach(function(el) {
            var filtered = window.__filterProfanity(el.textContent);
            if (filtered !== el.textContent) {
              el.textContent = filtered;
            }
          });
        }
      });
    });
  });
  observer.observe(document.body, { childList: true, subtree: true });
  
  // ===== No Search History Save =====
  // Clear search inputs on blur and prevent storage
  document.addEventListener('DOMContentLoaded', function() {
    // Intercept search inputs
    document.querySelectorAll('input[type="search"], input[placeholder*="搜索"], input[placeholder*="Search"], input[placeholder*="查找"]').forEach(function(input) {
      input.setAttribute('autocomplete', 'off');
      input.addEventListener('blur', function() {
        this.value = '';
      });
    });
  });
  
  // Override any search history storage
  var origSetItem = Storage.prototype.setItem;
  Storage.prototype.setItem = function(key, value) {
    if (key && (key.includes('search') || key.includes('history') || key.includes('query'))) {
      return; // Don't save search-related data
    }
    return origSetItem.call(this, key, value);
  };
})();
</script>

