// ================================================
// Voice Messages (added 2026-05-15)
// ================================================
let voiceRecorder = null;
let voiceRecording = false;

async function startVoiceRecording() {
  try {
    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
    voiceRecorder = new MediaRecorder(stream);
    const chunks = [];
    
    voiceRecorder.ondataavailable = (e) => { if (e.data.size > 0) chunks.push(e.data); };
    voiceRecorder.onstop = () => {
      const blob = new Blob(chunks, { type: 'audio/webm' });
      sendVoiceMessage(blob);
      stream.getTracks().forEach(t => t.stop());
    };
    
    voiceRecorder.start();
    voiceRecording = true;
    showToast('录音中... 点击停止', 'info');
    
    // Update UI
    const btn = document.getElementById('btnVoiceMsg');
    if (btn) btn.classList.add('recording');
  } catch (err) {
    showToast('无法访问麦克风: ' + err.message, 'error');
  }
}

function stopVoiceRecording() {
  if (voiceRecorder && voiceRecording) {
    voiceRecorder.stop();
    voiceRecording = false;
    const btn = document.getElementById('btnVoiceMsg');
    if (btn) btn.classList.remove('recording');
  }
}

async function sendVoiceMessage(audioBlob) {
  if (!currentConversationId) {
    showToast('请先选择对话', 'error');
    return;
  }
  
  try {
    const token = localStorage.getItem('fk_token');
    const formData = new FormData();
    formData.append('audio', audioBlob, 'voice-message.webm');
    formData.append('conversationId', currentConversationId);
    
    const res = await fetch(`${API_BASE}/messages/voice`, {
      method: 'POST',
      headers: { Authorization: `Bearer ${token}` },
      body: formData
    });
    
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    showToast('语音消息已发送', 'success');
  } catch (err) {
    showToast('发送语音失败: ' + err.message, 'error');
  }
}

