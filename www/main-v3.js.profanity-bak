/**
 * Upload encrypted file with backend
 */
async function uploadEncryptedFile(file, recipientId, onProgress) {
  try {
    if (typeof privacyAPI !== 'undefined') {
      // Initialize upload
      const CHUNK_SIZE = 1024 * 1024; // 1MB chunks
      const totalChunks = Math.ceil(file.size / CHUNK_SIZE);
      
      const initResponse = await privacyAPI.initFileUpload(
        file.name,
        file.size,
        file.type,
        recipientId,
        totalChunks
      );
      
      const uploadId = initResponse.uploadId;
      
      // Upload chunks
      for (let i = 0; i < totalChunks; i++) {
        const start = i * CHUNK_SIZE;
        const end = Math.min(start + CHUNK_SIZE, file.size);
        const chunk = file.slice(start, end);
        
        await privacyAPI.uploadChunk(uploadId, i, chunk);
        
        if (onProgress) {
          onProgress({
            chunk: i + 1,
            total: totalChunks,
            percentage: Math.round(((i + 1) / totalChunks) * 100)
          });
        }
      }
      
      // Complete upload
      // In production, generate actual encrypted key and hash
      const encryptedKey = 'encrypted-key-placeholder';
      const integrityHash = 'sha256-placeholder';
      
      const completeResponse = await privacyAPI.completeFileUpload(
        uploadId,
        encryptedKey,
        integrityHash
      );
      
      showToast('文件已安全上传', 'success');
      return completeResponse;
    }
  } catch (err) {
    console.error('[File] Upload failed:', err);
    showToast('文件上传失败', 'error');
    throw err;
  }
}

