      e2eeText.textContent = '加密';
      e2eeDetail.textContent = `${status.curve} · ${status.messagesSent + status.messagesReceived} 条消息`;
    }
  } else if (Crypto) {
    document.getElementById('chatPeerStatus').textContent = '已加密';
    document.getElementById('chatPeerStatus').style.color = 'var(--text-secondary)';
    if (e2eeBar) {
      e2eeBar.style.display = 'inline-flex';
      e2eeBar.className = 'e2ee-status-bar pending';
