// v3: 新增 — 获取或创建对话，得到 conversationId
async function ensureConversation(userId) {
  const token = localStorage.getItem('fk_token');
  try {
    const res = await fetch(`${API_BASE}/conversations/find-or-create`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
      body: JSON.stringify({ userId: userId })
    });
    if (res.ok) {
      const data = await res.json();
      currentConversationId = data.conversationId;
      console.log('[Chat v3] Conversation ID:', currentConversationId);
    } else {
      console.error('[Chat v3] Failed to create conversation:', res.status);
    }
  } catch (err) {
    console.error('[Chat v3] Error:', err);
  }
}

// v3: 使用 conversationId 加载消息（v2 用的是 peerId）
async function loadMessages(conversationId) {
  const list = document.getElementById('messagesList');
  list.innerHTML = '<div class="date-divider"><span>今天</span></div>';
  try {
    const token = localStorage.getItem('fk_token');
    const res = await fetch(`${API_BASE}/conversations/${conversationId}/messages?limit=50`, {
      headers: { Authorization: `Bearer ${token}` }
    });
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    const data = await res.json();
    const msgs = data.messages || [];
    msgs.sort((a, b) => a.createdAt - b.createdAt);
    for (const m of msgs) {
      const isSent = m.senderUserId === localStorage.getItem('fk_uid');
      let text;
      
      // v5: 前向保密解密 — 支持 v2 envelope 和 v1 兼容
      const Crypto = typeof MessageCryptoV2 !== 'undefined' ? MessageCryptoV2 : MessageCrypto;
      if (m.envelope && typeof Crypto !== 'undefined') {
        try {
          const envelope = JSON.parse(m.envelope);
          text = await Crypto.decrypt(m.senderUserId, envelope);
        } catch (e) {
          console.error('[Messages v5] Decrypt failed:', e.message);
          text = `⚠️ 解密失败: ${e.message}`;
        }
      } else if (m.encryptedContent && typeof MessageCrypto !== 'undefined') {
        try {
          text = await MessageCrypto.decrypt(m.senderUserId, m.encryptedContent);
        } catch (e) {
          console.error('[Messages v5] Legacy decrypt failed:', e);
          text = '[⚠️ 无法解密（旧格式）]';
        }
      } else {
        text = decodeCiphertext(m.ciphertext);
      }
      
      // 标记加密消息（v2 envelope 或 encryptedContent）
      const isEncrypted = !!(m.envelope || m.encryptedContent);
      const msgId = appendMessage(isSent, text || '[Unable to decrypt]', m.createdAt, isEncrypted, null, null, m.id);
    }
  } catch (err) {
    console.error('[Messages v3] Load failed:', err);
  }
  document.getElementById('messageInput').focus();
}

// 消息状态常量
const MessageStatus = {
  SENDING: 'sending',     // 发送中
  SENT: 'sent',           // 已发送（服务器确认）
  DELIVERED: 'delivered', // 已送达（对方收到）
  READ: 'read',           // 已读
  FAILED: 'failed'        // 发送失败
};

// 生成消息唯一ID
function generateMessageId() {
  return 'msg_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);
}

// 获取状态图标HTML
function getStatusIcon(status) {
  switch (status) {
    case MessageStatus.SENDING:
      return '<span class="msg-status sending" title="Sending..."><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v4m0 12v4M4.93 4.93l2.83 2.83m8.48 8.48l2.83 2.83M2 12h4m12 0h4M4.93 19.07l2.83-2.83m8.48-8.48l2.83-2.83"/></svg></span>';
    case MessageStatus.SENT:
      return '<span class="msg-status sent" title="已发送">✓</span>';
    case MessageStatus.DELIVERED:
      return '<span class="msg-status delivered" title="已送达">✓✓</span>';
    case MessageStatus.READ:
      return '<span class="msg-status read" title="已读">✓✓</span>';
    case MessageStatus.FAILED:
      return '<span class="msg-status failed" title="发送失败">✗</span>';
    default:
      return '';
  }
}

// v8: 更新消息状态（支持已读回执）
// [REMOVED] 重复定义 — 实际定义在下方 line ~1030，此处删除避免混淆
// 消息撤回时间限制（毫秒）
const RECALL_TIME_LIMIT = 2 * 60 * 1000; // 2分钟

function appendMessage(sent, text, timestamp, isEncrypted = false, status = null, messageId = null, serverMessageId = null) {
  const list = document.getElementById('messagesList');
  const time = timestamp ? formatTime(timestamp) : formatTime(Date.now());
  const msg = document.createElement('div');
  const msgId = messageId || generateMessageId();
  msg.className = `message ${sent ? 'sent' : 'received'}`;
  msg.dataset.messageId = msgId;
  if (serverMessageId) msg.dataset.serverMessageId = serverMessageId;
  msg.dataset.timestamp = timestamp || Date.now();
  msg.dataset.recalled = 'false';
  
  const e2eeBadge = isEncrypted ? '<span class="e2ee-badge" title="End-to-end encrypted"></span>' : '';
  const statusIcon = sent && status ? getStatusIcon(status) : '';
  
  msg.innerHTML = `
    <div class="msg-bubble">${escapeHtml(text)}${e2eeBadge}</div>
    <div class="msg-meta">
      <span class="msg-time">${time}</span>
      ${statusIcon}
    </div>
  `;
  
  // v7: 右键菜单（仅对已发送消息）
  if (sent) {
    msg.addEventListener('contextmenu', (e) => {
      e.preventDefault();
      showMessageContextMenu(e, msgId);
    });
  }
  
  list.appendChild(msg);
  list.scrollTop = list.scrollHeight;
  return msgId;
}

// v7: 显示消息右键菜单
function showMessageContextMenu(e, messageId) {
  // 移除现有菜单
  const existingMenu = document.querySelector('.msg-context-menu');
  if (existingMenu) existingMenu.remove();
  
  const msg = document.querySelector(`[data-message-id="${messageId}"]`);
  if (!msg) return;
  
  const timestamp = parseInt(msg.dataset.timestamp);
  const isRecalled = msg.dataset.recalled === 'true';
  const isWithinTimeLimit = (Date.now() - timestamp) < RECALL_TIME_LIMIT;
  
  const menu = document.createElement('div');
  menu.className = 'msg-context-menu';
  menu.style.cssText = `position:fixed;left:${e.clientX}px;top:${e.clientY}px;z-index:10000;`;
  
  let menuItems = '';
  
  // 撤回选项（仅在时间限制内且未撤回）
  if (isWithinTimeLimit && !isRecalled) {
    menuItems += `<div class="msg-menu-item recall" onclick="recallMessage('${messageId}')">
      <span>↩️</span> 撤回消息
    </div>`;
  }
  
  // 复制选项
  menuItems += `<div class="msg-menu-item" onclick="copyMessageText('${messageId}')">
    <span>📋</span> 复制文本
  </div>`;
  
  // 删除选项（仅本地删除）
  menuItems += `<div class="msg-menu-item delete" onclick="deleteMessageLocal('${messageId}')">
    <span>🗑️</span> 删除
  </div>`;
  
  menu.innerHTML = menuItems;
  document.body.appendChild(menu);
  
  // 点击其他地方关闭菜单
  const closeMenu = () => {
    menu.remove();
    document.removeEventListener('click', closeMenu);
  };
  setTimeout(() => document.addEventListener('click', closeMenu), 0);
}

// v7: 撤回消息
async function recallMessage(messageId) {
  const msg = document.querySelector(`[data-message-id="${messageId}"]`);
  if (!msg) return;
  
  const timestamp = parseInt(msg.dataset.timestamp);
  if ((Date.now() - timestamp) > RECALL_TIME_LIMIT) {
    showToast('消息发送超过2分钟，无法撤回', 'warning');
    return;
  }
  
  const serverMessageId = msg.dataset.serverMessageId;
  const token = localStorage.getItem('fk_token');
  
  try {
    // 发送撤回请求到服务器
    const response = await fetch(`${API_BASE}/messages/recall`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${token}`
      },
      body: JSON.stringify({
        messageId: serverMessageId || messageId,
        clientMessageId: messageId,
        conversationId: currentConversationId,
        peerId: currentPeerId
      })
    });
    
    if (response.ok) {
      // 本地标记为已撤回
      markMessageRecalled(messageId);
      showToast('消息已撤回', 'success');
      
      // 通过 WebSocket 通知对方
      if (wsManager && wsManager.isConnected()) {
        wsManager.sendRaw(JSON.stringify({
          type: 'recall_message',
          to: currentPeerId,
          clientMessageId: messageId,
          serverMessageId: serverMessageId,
          conversationId: currentConversationId
        }));
      }
    } else {
      const err = await response.json();
      showToast('撤回失败: ' + (err.message || '未知错误'), 'error');
    }
  } catch (err) {
    console.error('[Recall] Failed:', err);
    showToast('撤回失败: 网络错误', 'error');
  }
  
  // 关闭菜单
  const menu = document.querySelector('.msg-context-menu');
  if (menu) menu.remove();
}

// v7: 标记消息为已撤回
function markMessageRecalled(messageId) {
  const msg = document.querySelector(`[data-message-id="${messageId}"]`);
  if (!msg) return;
  
  msg.dataset.recalled = 'true';
  msg.classList.add('recalled');
  
  const bubble = msg.querySelector('.msg-bubble');
  if (bubble) {
    bubble.innerHTML = '<em style="opacity:0.6;font-style:italic;">🚫 此消息已撤回</em>';
  }
  
  // 移除状态图标
  const meta = msg.querySelector('.msg-meta');
  if (meta) {
    const statusIcon = meta.querySelector('.msg-status');
    if (statusIcon) statusIcon.remove();
    const retryBtn = meta.querySelector('.msg-retry-btn');
    if (retryBtn) retryBtn.remove();
  }
}

// v7: 复制消息文本
function copyMessageText(messageId) {
  const msg = document.querySelector(`[data-message-id="${messageId}"]`);
  if (!msg) return;
  
  const bubble = msg.querySelector('.msg-bubble');
  if (!bubble) return;
  
  const text = bubble.textContent;
  navigator.clipboard.writeText(text).then(() => {
    showToast('已复制到剪贴板', 'success');
  }).catch(() => {
    showToast('复制失败', 'error');
  });
  
  // 关闭菜单
  const menu = document.querySelector('.msg-context-menu');
  if (menu) menu.remove();
}

// v7: 本地删除消息
function deleteMessageLocal(messageId) {
  const msg = document.querySelector(`[data-message-id="${messageId}"]`);
  if (msg) {
    msg.style.transition = 'all 0.3s ease';
    msg.style.opacity = '0';
    msg.style.transform = 'translateX(100%)';
    setTimeout(() => msg.remove(), 300);
  }
  
  // 关闭菜单
  const menu = document.querySelector('.msg-context-menu');
  if (menu) menu.remove();
}

// 更新消息状态
function updateMessageStatus(messageId, status) {
  const msg = document.querySelector(`[data-message-id="${messageId}"]`);
  if (!msg) return;
  
  const meta = msg.querySelector('.msg-meta');
  if (!meta) return;
  
  // 移除旧的状态图标
  const oldStatus = meta.querySelector('.msg-status');
  if (oldStatus) oldStatus.remove();
  
  // 添加新的状态图标
  const statusIcon = getStatusIcon(status);
  if (statusIcon) {
    meta.insertAdjacentHTML('beforeend', statusIcon);
  }
  
  // 如果失败，添加重试按钮
  if (status === MessageStatus.FAILED) {
    const retryBtn = document.createElement('button');
    retryBtn.className = 'msg-retry-btn';
    retryBtn.textContent = '重试';
    retryBtn.onclick = () => retryMessage(messageId);
    meta.appendChild(retryBtn);
  }
}

// 重发消息
async function retryMessage(messageId) {
  const msg = document.querySelector(`[data-message-id="${messageId}"]`);
  if (!msg) return;
  
  const bubble = msg.querySelector('.msg-bubble');
  if (!bubble) return;
  
  const text = bubble.textContent;
  const retryBtn = msg.querySelector('.msg-retry-btn');
  if (retryBtn) retryBtn.remove();
  
  // 重新发送
  await sendMessageWithStatus(text, messageId);
}

async function sendMessage() {
  const input = document.getElementById('messageInput');
  const text = input.value.trim();
  if (!text || !currentPeerId) return;

  if (!currentConversationId) {
    await ensureConversation(currentPeerId);
  }
  if (!currentConversationId) {
    showToast('创建会话失败', 'error');
    return;
  }

  // v5.1: 自动建立加密会话（如果尚未建立）
  const Crypto = typeof MessageCryptoV2 !== 'undefined' ? MessageCryptoV2 : MessageCrypto;
  if (typeof Crypto !== 'undefined' && Crypto.hasSession) {
    try {
      const hasSession = await Crypto.hasSession(currentPeerId);
      if (!hasSession) {
        console.log(`[Send v5.1] No session with ${currentPeerId}, attempting X3DH initiation...`);
        showToast('正在建立安全会话...', 'info');
        
        // 尝试从服务器获取对方的 pre-key bundle
        try {
          const token = localStorage.getItem('fk_token');
          const response = await fetch(`${API_BASE}/privacy/prekey-bundle/${currentPeerId}`, {
            headers: { 'Authorization': `Bearer ${token}` }
          });
          
          if (response.ok) {
            const bundle = await response.json();
            if (bundle && bundle.identityKey) {
              await Crypto.initiateSession(currentPeerId, bundle);
              console.log(`[Send v5.1] X3DH session established with ${currentPeerId}`);
              showToast('安全会话已建立', 'success');
            } else {
              console.warn(`[Send v5.1] No pre-key bundle available for ${currentPeerId}`);
              showToast('对方尚未上传密钥，无法建立加密会话', 'warning');
            }
          } else if (response.status === 404) {
            console.warn(`[Send v5.1] Pre-key bundle not found for ${currentPeerId}`);
            showToast('对方尚未注册加密密钥，无法发送加密消息', 'warning');
          } else {
            console.error('[Send v5.1] Failed to fetch pre-key bundle:', response.status);
            showToast('获取加密密钥失败', 'error');
          }
        } catch (x3dhErr) {
          console.error('[Send v5.1] X3DH initiation failed:', x3dhErr.message);
          showToast('建立加密会话失败: ' + x3dhErr.message, 'error');
        }
      }
    } catch (e) {
      console.warn('[Send v5.1] Session check failed:', e.message);
    }
  }

  input.value = '';

  // Check if burn mode is enabled
  if (burnMode) {
    await sendBurnMessage(text, burnTimeout);
    burnMode = false;
    const btnBurn = document.getElementById('btnBurn');
    if (btnBurn) {
      btnBurn.classList.remove('active');
      btnBurn.style.color = '';
    }
    return;
  }

  // 使用新的状态系统发送消息
  await sendMessageWithStatus(text);
}

// v6: 带状态指示的消息发送
async function sendMessageWithStatus(text, retryMsgId = null) {
  const token = localStorage.getItem('fk_token');
  let messageId = retryMsgId;
  let isEncrypted = false;
  
  // v5: 前向保密加密 — 优先使用 MessageCryptoV2（完整X3DH + Double Ratchet）
  let payload;
  const Crypto = typeof MessageCryptoV2 !== 'undefined' ? MessageCryptoV2 : MessageCrypto;
  if (typeof Crypto !== 'undefined') {
    try {
      const envelope = await Crypto.encrypt(currentPeerId, text);
      isEncrypted = true;
      payload = {
        conversationId: currentConversationId,
        envelope: JSON.stringify(envelope),
        protocol: envelope.protocol || 'double-ratchet',
        version: envelope.version || 1,
        messageType: 'e2ee',
        burnAfterRead: false
      };
      console.log(`[Send v6] E2EE message — protocol=${envelope.protocol} v${envelope.version}`);
    } catch (encryptErr) {
      console.error('[Send v6] ENCRYPTION FAILED:', encryptErr.message);
      showToast('⚠️ 加密失败: ' + encryptErr.message + ' — 消息未发送', 'error');
      return;
    }
  } else {
    console.warn('[Send v6] No crypto module available — message NOT sent for security');
    showToast('⚠️ 安全模块未加载，消息未发送。请刷新页面重试。', 'error');
    return;
  }

  // 如果是重试，更新现有消息状态为发送中
  if (messageId) {
    updateMessageStatus(messageId, MessageStatus.SENDING);
  } else {
    // 新消息：显示为发送中
    messageId = appendMessage(true, text, Date.now(), isEncrypted, MessageStatus.SENDING);
  }

  try {
    // v4: WebSocket 优先，REST 备选
    if (wsManager && wsManager.isConnected()) {
      wsManager.sendRaw(JSON.stringify({
        type: 'message',
        to: currentPeerId,
        clientMessageId: messageId,  // 让服务器可以回传状态
        ...payload
      }));
      console.log('[Send v6] Message sent via WebSocket, awaiting acknowledgment...');
      // v9: WebSocket 发送超时 — 15秒内无 ack 则标记 SENT（避免永久 SENDING）
      const ackTimeoutId = setTimeout(() => {
        const msgEl = document.querySelector(`[data-message-id="${messageId}"]`);
        if (msgEl && msgEl.dataset.status !== 'sent' && msgEl.dataset.status !== 'delivered' && msgEl.dataset.status !== 'read') {
          console.warn('[Send v9] WebSocket ack timeout, marking as SENT');
          updateMessageStatus(messageId, MessageStatus.SENT);
        }
      }, 15000);
      // ack 到达时清除超时（通过全局 Map 追踪）
      if (!window._wsAckTimers) window._wsAckTimers = new Map();
      window._wsAckTimers.set(messageId, ackTimeoutId);
      return;
    }

    // REST API 发送
    const msgRes = await fetch(`${API_BASE}/messages`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
      body: JSON.stringify({...payload, clientMessageId: messageId})
    });
    
    if (!msgRes.ok) {
      throw new Error(`HTTP ${msgRes.status}`);
    }
    
    const result = await msgRes.json();
    console.log('[Send v6] Message sent via REST API, server ID:', result.messageId || result.id);
    
    // 更新为已发送状态
    updateMessageStatus(messageId, MessageStatus.SENT);
    
    // 存储服务器消息ID用于后续状态更新
    if (result.messageId || result.id) {
      const msgEl = document.querySelector(`[data-message-id="${messageId}"]`);
      if (msgEl) {
        msgEl.dataset.serverMessageId = result.messageId || result.id;
      }
    }
    
  } catch (err) {
    console.error('[Send v6] Error:', err);
    updateMessageStatus(messageId, MessageStatus.FAILED);
    showToast('发送失败: ' + err.message, 'error');
  }
}

