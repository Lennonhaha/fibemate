// ================================================

let msgSearchState = {
  active: false,
  query: '',
  matches: [],
  currentIndex: -1
};

function initMessageSearch() {
  const btnSearch = document.getElementById('btnSearchMsg');
  const searchBar = document.getElementById('msgSearchBar');
  const searchInput = document.getElementById('msgSearchInput');
  const btnPrev = document.getElementById('btnSearchPrev');
  const btnNext = document.getElementById('btnSearchNext');
  const btnClose = document.getElementById('btnSearchClose');

  if (!btnSearch || !searchBar) return;

  btnSearch.addEventListener('click', () => {
    msgSearchState.active = true;
    searchBar.style.display = 'flex';
    searchInput.focus();
  });

  btnClose.addEventListener('click', closeMessageSearch);

  searchInput.addEventListener('input', debounce((e) => {
    performMessageSearch(e.target.value.trim());
  }, 200));

  searchInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') navigateSearchResult(1);
    if (e.key === 'Escape') closeMessageSearch();
  });

  btnPrev.addEventListener('click', () => navigateSearchResult(-1));
  btnNext.addEventListener('click', () => navigateSearchResult(1));
}

function performMessageSearch(query) {
  const countEl = document.getElementById('msgSearchCount');
  const messagesList = document.getElementById('messagesList');

  // 清除旧高亮
  clearSearchHighlights();
  msgSearchState.matches = [];
  msgSearchState.currentIndex = -1;

  if (!query || query.length < 1) {
    if (countEl) countEl.textContent = '';
    return;
  }

  msgSearchState.query = query;

  if (!messagesList) return;

  const bubbles = messagesList.querySelectorAll('.msg-bubble');
  const lowerQuery = query.toLowerCase();

  bubbles.forEach((bubble, idx) => {
    const text = bubble.textContent || '';
    if (text.toLowerCase().includes(lowerQuery)) {
      msgSearchState.matches.push(bubble);
      highlightText(bubble, query);
    }
  });

  if (countEl) {
    const total = msgSearchState.matches.length;
    countEl.textContent = total > 0 ? `${total} 个匹配` : '无匹配结果';
  }

  if (msgSearchState.matches.length > 0) {
    navigateSearchResult(1);
  }
}

function highlightText(element, query) {
  const walker = document.createTreeWalker(element, NodeFilter.SHOW_TEXT, null, false);
  const textNodes = [];
  let node;
  while (node = walker.nextNode()) {
    if (node.textContent.toLowerCase().includes(query.toLowerCase())) {
      textNodes.push(node);
    }
  }

  textNodes.forEach(node => {
    const span = document.createElement('span');
    const regex = new RegExp(`(${escapeRegExp(query)})`, 'gi');
    span.innerHTML = node.textContent.replace(regex, '<mark class="msg-highlight">$1</mark>');
    const parent = node.parentNode;
    while (span.firstChild) {
      parent.insertBefore(span.firstChild, node);
    }
    parent.removeChild(node);
  });
}

function clearSearchHighlights() {
  const messagesList = document.getElementById('messagesList');
  if (!messagesList) return;

  const marks = messagesList.querySelectorAll('mark.msg-highlight, mark.msg-highlight-current');
  marks.forEach(mark => {
    const parent = mark.parentNode;
    parent.insertBefore(document.createTextNode(mark.textContent), mark);
    parent.removeChild(mark);
    parent.normalize();
  });
}

function navigateSearchResult(direction) {
  const matches = msgSearchState.matches;
  if (matches.length === 0) return;

  // 移除旧的高亮
  const oldMark = messagesList.querySelector('mark.msg-highlight-current');
  if (oldMark) {
    oldMark.classList.remove('msg-highlight-current');
    oldMark.classList.add('msg-highlight');
  }

  msgSearchState.currentIndex += direction;
  if (msgSearchState.currentIndex >= matches.length) msgSearchState.currentIndex = 0;
  if (msgSearchState.currentIndex < 0) msgSearchState.currentIndex = matches.length - 1;

  const target = matches[msgSearchState.currentIndex];
  const mark = target.querySelector('mark.msg-highlight');
  if (mark) {
    mark.classList.remove('msg-highlight');
    mark.classList.add('msg-highlight-current');
  }

  target.scrollIntoView({ behavior: 'smooth', block: 'center' });

  const countEl = document.getElementById('msgSearchCount');
  if (countEl) {
    countEl.textContent = `${msgSearchState.currentIndex + 1} / ${matches.length}`;
  }
}

function closeMessageSearch() {
  const searchBar = document.getElementById('msgSearchBar');
  const searchInput = document.getElementById('msgSearchInput');

  msgSearchState.active = false;
  msgSearchState.query = '';
  msgSearchState.matches = [];
  msgSearchState.currentIndex = -1;

  if (searchBar) searchBar.style.display = 'none';
  if (searchInput) searchInput.value = '';

  clearSearchHighlights();
}

function escapeRegExp(string) {
  return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}

function debounce(func, wait) {
  let timeout;
  return function executedFunction(...args) {
    const later = () => {
      clearTimeout(timeout);
      func(...args);
    };
    clearTimeout(timeout);
    timeout = setTimeout(later, wait);
  };
}

