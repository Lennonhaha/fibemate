function initNavigation() {
  document.querySelectorAll('.nav-tab').forEach(tab => {
    tab.addEventListener('click', async () => {
      const target = tab.dataset.tab;
      await switchTab(target);
    });
  });
}

async function switchTab(tab) {
  currentTab = tab;
  document.querySelectorAll('.nav-tab').forEach(t => t.classList.toggle('active', t.dataset.tab === tab));
  document.querySelectorAll('.tab-panel').forEach(p => p.classList.toggle('active', p.id === `panel${capitalize(tab)}`));
  hideAllMainViews();
  if (tab === 'messages') {
    document.getElementById('chatEmpty').style.display = 'flex';
  } else if (tab === 'keys') {
    const kv = document.getElementById('keyDetailView');
    console.log('[Keys] switchTab keys, keyDetailView:', kv, 'display before:', kv?.style.display);
    kv.style.display = 'flex';
    console.log('[Keys] display after:', kv?.style.display);
    try {
      await renderKeyManagement();
      console.log('[Keys] renderKeyManagement completed, keyCards children:', document.getElementById('keyCards')?.children.length);
    } catch (err) {
      console.error('[Keys] Failed to render:', err);
      alert('[密钥面板错误] ' + err.message);
    }
  } else if (tab === 'community') {
    document.getElementById('communityDetailView').style.display = 'flex';
    try {
      if (typeof NexusCommunity !== 'undefined') {
        NexusCommunity.initAPI();
        NexusCommunity.loadSpaces();
      }
    } catch (err) {
      console.error('[Nexus] Failed to render:', err);
    }
  } else if (tab === 'settings') {
    const sv = document.getElementById('settingsDetailView');
    console.log('[Settings] switchTab settings, settingsDetailView:', sv, 'display before:', sv?.style.display);
    sv.style.display = 'flex';
    console.log('[Settings] display after:', sv?.style.display);
    try {
      renderSettings();
      console.log('[Settings] renderSettings completed, settingsSections children:', document.getElementById('settingsSections')?.children.length);
    } catch (err) {
      console.error('[Settings] Failed to render:', err);
      alert('[设置面板错误] ' + err.message);
    }
  }
  const placeholders = { messages: '搜索消息...', contacts: '搜索联系人...', vault: '搜索保险库...', keys: '搜索密钥...', community: '搜索频道...', settings: '搜索设置...' };
  document.getElementById('searchInput').placeholder = placeholders[tab] || '搜索...';
}

