// WebSocket  — v3 改为 ws://8.156.77.68:3001/ws
// ================================================
// WebSocket stability tracking (P1-1)
let wsStats = {
  connectedAt: null,
  disconnectedAt: null,
  reconnectCount: 0,
  messageCount: 0,
  errorCount: 0,
  lastPingTime: null,
  lastPongTime: null,
  latencyHistory: [] // Track last 50 latencies for analysis
};

function connectWebSocket() {
  const token = localStorage.getItem('fk_token');
  if (!token) return;
  try {
    // 使用与 API 相同的地址，但协议改为 wss
    const apiBase = API_BASE.replace('https://', 'wss://').replace('http://', 'ws://').replace('/api', '');
    const url = `${apiBase}/ws?token=${token}`;
    
    // 使用共享 WebSocket 管理器
    if (wsManager) {
      wsManager.connect(url);
      
      // 注册消息处理器
      wsManager.on('pong', (msg) => {
        wsStats.lastPongTime = Date.now();
        if (msg.timestamp) {
          const latency = Date.now() - msg.timestamp;
          wsStats.latencyHistory.push(latency);
          if (wsStats.latencyHistory.length > 50) wsStats.latencyHistory.shift();
          console.log(`[WS] Heartbeat latency: ${latency}ms`);
        }
      });
      
      wsManager.on('message_ack', (msg) => {
        console.log('[WS v6] Message acknowledged:', msg.clientMessageId, 'status:', msg.status);
        if (msg.clientMessageId) {
          if (window._wsAckTimers && window._wsAckTimers.has(msg.clientMessageId)) {
            clearTimeout(window._wsAckTimers.get(msg.clientMessageId));
            window._wsAckTimers.delete(msg.clientMessageId);
          }
          const status = msg.status === 'delivered' ? MessageStatus.DELIVERED : 
                        msg.status === 'read' ? MessageStatus.READ : MessageStatus.SENT;
          updateMessageStatus(msg.clientMessageId, status);
        }
      });
      
      wsManager.on('new_message', async (msg) => {
        wsStats.messageCount++;
        if (msg.from === currentPeerId) {
          let text;
          const Crypto = typeof MessageCryptoV2 !== 'undefined' ? MessageCryptoV2 : MessageCrypto;
          if (msg.envelope && typeof Crypto !== 'undefined') {
            try {
              const envelope = JSON.parse(msg.envelope);
              text = await Crypto.decrypt(msg.from, envelope);
              console.log(`[WS v5] E2EE message decrypted (protocol=${envelope.protocol})`);
            } catch (decryptErr) {
              console.error('[WS v5] DECRYPT FAILED:', decryptErr.message);
              appendMessage(false, `⚠️ 解密失败\n${decryptErr.message}`, msg.createdAt || Date.now());
              showToast('🔒 安全警告: 消息解密失败，可能安全受损', 'error', 8000);
              return;
            }
          } else if (msg.encryptedContent && typeof MessageCrypto !== 'undefined') {
            try {
              text = await MessageCrypto.decrypt(msg.from, msg.encryptedContent);
              console.log('[WS v5] Legacy decrypt (v1 format)');
            } catch (legacyErr) {
              console.error('[WS v5] Legacy decrypt failed:', legacyErr);
              text = '[⚠️ 无法解密（旧格式）]';
            }
          } else if (msg.ciphertext) {
            text = decodeCiphertext(msg.ciphertext);
          } else {
            text = msg.content || msg.text || '[无法读取]';
          }
          appendMessage(false, text || '[Unable to decrypt]', msg.createdAt || Date.now(), true);
          
          if (wsManager.isConnected() && msg.serverMessageId) {
            wsManager.sendRaw(JSON.stringify({
              type: 'read_receipt',
              messageId: msg.serverMessageId,
              from: localStorage.getItem('fk_uid')
            }));
          }
        } else {
          showToast(`新消息来自 ${msg.from}`, 'info');
          loadConversations();
        }
      });
      
      wsManager.on('offline_messages', (msg) => {
        console.log('[WS v4] Offline messages:', msg.count);
      });
      
      wsManager.on('read_receipt', (msg) => {
        console.log('[WS v6] Read receipt for message:', msg.messageId);
        if (msg.messageId) {
          const msgEl = document.querySelector(`[data-server-message-id="${msg.messageId}"]`);
          if (msgEl) {
            updateMessageStatus(msgEl.dataset.messageId, MessageStatus.READ);
          }
        }
      });
      
      wsManager.on('recall_message', (msg) => {
        console.log('[WS v7] Peer recalled message:', msg.clientMessageId);
        if (msg.clientMessageId) {
          markMessageRecalled(msg.clientMessageId);
          showToast('对方撤回了一条消息', 'info');
        }
      });
      
      wsManager.on('connected', () => {
        console.log('[WS v3] Connected to proxy');
        wsStats.connectedAt = Date.now();
        wsStats.reconnectCount++;
        startHeartbeat();
      });
      
      wsManager.on('disconnected', () => {
        console.log('[WS v3] Disconnected, will auto-reconnect via wsManager');
        wsStats.disconnectedAt = Date.now();
        stopHeartbeat();
      });
      
      wsManager.on('error', (err) => {
        console.error('[WS v3] Error:', err);
        wsStats.errorCount++;
      });
      
      // Fallback 原生 WebSocket 已移除 — 统一使用 wsManager
      console.warn('[WS] wsManager not available, WebSocket not initialized');
      return;
  } catch (err) {
    console.error('[WS v3] Connect error:', err);
  }
}

// ================================================
// WebSocket Connection Stats (P1-2)
// ================================================

let heartbeatInterval = null;
let heartbeatTimeout = null;
const HEARTBEAT_INTERVAL = 30000; // 30s
const HEARTBEAT_TIMEOUT = 10000;  // 10s

function startHeartbeat() {
  stopHeartbeat();
  heartbeatInterval = setInterval(() => {
    if (wsManager && wsManager.isConnected()) {
      wsStats.lastPingTime = Date.now();
      wsManager.sendRaw(JSON.stringify({ type: 'ping', timestamp: Date.now() }));
      
      heartbeatTimeout = setTimeout(() => {
        console.warn('[WS] Heartbeat timeout - connection may be dead');
        wsManager.disconnect();
      }, HEARTBEAT_TIMEOUT);
    }
  }, HEARTBEAT_INTERVAL);
}

function stopHeartbeat() {
  if (heartbeatInterval) {
    clearInterval(heartbeatInterval);
    heartbeatInterval = null;
  }
  if (heartbeatTimeout) {
    clearTimeout(heartbeatTimeout);
    heartbeatTimeout = null;
  }
}

