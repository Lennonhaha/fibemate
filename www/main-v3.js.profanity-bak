async function checkForUpdates() {
  try {
    const res = await fetch(`${API_BASE}/version`);
    if (!res.ok) return;
    const data = await res.json();
    const currentVersion = '2.0.0-alpha';
    const latestVersion = data.version;
    
    if (latestVersion && latestVersion !== currentVersion) {
      showToast(`新版本 ${latestVersion} 可用`, 'info');
      // Store update info
      localStorage.setItem('fk_update_available', JSON.stringify({
        current: currentVersion,
        latest: latestVersion,
        url: data.downloadUrl || '',
        notes: data.releaseNotes || ''
      }));
    }
  } catch (err) {
    console.log('[Update] Check failed:', err.message);
  }
}

function showUpdateNotification() {
  const updateInfo = localStorage.getItem('fk_update_available');
  if (!updateInfo) return;
  
  try {
    const info = JSON.parse(updateInfo);
    
    // Create or reuse dedicated update modal
    let modal = document.getElementById('modalUpdateNotify');
    if (!modal) {
      modal = document.createElement('div');
      modal.id = 'modalUpdateNotify';
      modal.className = 'modal-overlay';
      modal.style.display = 'none';
      document.body.appendChild(modal);
    }
    
    modal.innerHTML = `
      <div class="modal-content" style="max-width: 380px;">
        <div style="padding: 16px;">
          <h4 style="margin-bottom: 8px;">🔄 新版本可用</h4>
          <p style="color: var(--text-secondary); font-size: 13px; margin-bottom: 12px;">
            当前: ${escapeHtml(info.current || '')}<br>
            最新: ${escapeHtml(info.latest || '')}
          </p>
          ${info.notes ? `<p style="font-size: 12px; color: var(--text-muted); margin-bottom: 12px;">${escapeHtml(info.notes)}</p>` : ''}
          <div style="display: flex; gap: 8px;">
            <button class="btn-secondary" onclick="document.getElementById('modalUpdateNotify').style.display='none'">稍后</button>
            ${info.url ? `<a href="${escapeHtml(info.url)}" target="_blank" class="btn-primary" style="text-decoration: none;">下载更新</a>` : ''}
          </div>
        </div>
      </div>
    `;
    modal.style.display = 'flex';
  } catch (e) {}
}

