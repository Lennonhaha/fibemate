// ================================================
// Intersection Observer for Auto Read Receipt
// ================================================

let readReceiptObserver = null;

/**
 * Initialize intersection observer to auto-send read receipts
 * when messages come into view
 */
function initReadReceiptObserver() {
  if (readReceiptObserver) {
    readReceiptObserver.disconnect();
  }
  
  const messagesList = document.getElementById('messagesList');
  if (!messagesList) return;
  
  readReceiptObserver = new IntersectionObserver((entries) => {
    const readMessages = [];
    
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const msg = entry.target;
        if (msg.classList.contains('received') && !msg.dataset.read) {
          const serverId = msg.dataset.serverMessageId;
          if (serverId) {
            readMessages.push(serverId);
            msg.dataset.read = 'true';
          }
        }
      }
    });
    
    if (readMessages.length > 0 && currentConversationId) {
      sendReadReceipt(currentConversationId, readMessages);
    }
  }, {
    root: messagesList,
    threshold: 0.5 // Message must be 50% visible
  });
  
  // Observe all received messages
  messagesList.querySelectorAll('.message.received').forEach(msg => {
    readReceiptObserver.observe(msg);
  });
}

