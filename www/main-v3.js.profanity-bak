/**
 * Send read receipt for messages in current conversation
 * Called when user opens a chat or scrolls to view messages
 */
async function sendReadReceipt(conversationId, messageIds) {
  if (!conversationId || !messageIds || messageIds.length === 0) return;
  
  // Check if user has enabled read receipts
  const readReceiptsEnabled = localStorage.getItem('fk_setting_readReceipts') !== 'false';
  if (!readReceiptsEnabled) {
    console.log('[ReadReceipt] Disabled by user preference');
    return;
  }
  
  try {
    const token = localStorage.getItem('fk_token');
    const payload = {
      conversationId,
      messageIds: Array.isArray(messageIds) ? messageIds : [messageIds],
      readAt: Date.now()
    };
    
    // Try WebSocket first, fallback to REST
    if (wsManager && wsManager.isConnected()) {
      wsManager.sendRaw(JSON.stringify({
        type: 'read_receipt',
        ...payload
      }));
      console.log('[ReadReceipt] Sent via WebSocket:', messageIds.length, 'messages');
    } else {
      // REST fallback
      const res = await fetch(`${API_BASE}/messages/read-receipt`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify(payload)
      });
      
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      console.log('[ReadReceipt] Sent via REST API:', messageIds.length, 'messages');
    }
    
    // Mark locally as read
    messageIds.forEach(id => markMessageAsReadLocally(id));
  } catch (err) {
    console.error('[ReadReceipt] Failed to send:', err);
  }
}

/**
 * Mark message as read locally (update UI)
 */
function markMessageAsReadLocally(messageId) {
  const msg = document.querySelector(`[data-message-id="${messageId}"]`);
  if (msg) {
    msg.dataset.read = 'true';
    // Update status icon if it's a sent message
    if (msg.classList.contains('sent')) {
      updateMessageStatus(messageId, MessageStatus.READ);
    }
  }
}

/**
 * Handle incoming read receipt from other user
 */
function handleIncomingReadReceipt(data) {
  const { from, messageIds, readAt } = data;
  
  console.log('[ReadReceipt] Received from', from, ':', messageIds.length, 'messages read at', new Date(readAt).toLocaleTimeString());
  
  // Update UI for each message
  messageIds.forEach(id => {
    updateMessageStatus(id, MessageStatus.READ);
  });
  
  // Show subtle notification
  if (currentPeerId === from) {
    // User is currently chatting with this person, update status text
    const statusEl = document.getElementById('chatPeerStatus');
    if (statusEl) {
      const originalText = statusEl.textContent;
      statusEl.textContent = '刚刚已读';
      statusEl.style.color = 'var(--accent, #00E5C3)';
      
      setTimeout(() => {
        statusEl.textContent = originalText;
        statusEl.style.color = '';
      }, 3000);
    }
  }
}

/**
 * Mark all visible messages in current conversation as read
 * Call this when opening a chat or when new messages arrive while in view
 */
async function markConversationAsRead() {
  if (!currentConversationId) return;
  
  const messagesList = document.getElementById('messagesList');
  if (!messagesList) return;
  
  // Find all received (not sent by me) messages that haven't been marked as read
  const unreadMessages = messagesList.querySelectorAll('.message.received:not([data-read="true"])');
  const messageIds = [];
  
  unreadMessages.forEach(msg => {
    const serverId = msg.dataset.serverMessageId;
    if (serverId) {
      messageIds.push(serverId);
      msg.dataset.read = 'true';
    }
  });
  
  if (messageIds.length > 0) {
    await sendReadReceipt(currentConversationId, messageIds);
  }
}

