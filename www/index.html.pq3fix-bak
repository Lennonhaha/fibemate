    <!-- Trusted Timestamp (RFC 3161) — Crypto Core Status -->
    <div class="timestamp-proof" style="max-width: 900px; margin: 2rem auto 0; padding: 1.5rem 2rem; background: rgba(0,212,170,0.05); border: 1px solid rgba(0,212,170,0.2); border-radius: 8px; text-align: left;">
        <p style="margin: 0 0 0.8rem; font-size: 0.75rem; color: #00d4aa; letter-spacing: 2px; text-transform: uppercase;">Trusted Timestamp / RFC 3161 &mdash; 后量子加密核心状态</p>
        
        <!-- 2026-05-21 -->
        <p style="margin: 0 0 0.3rem; font-size: 0.9rem; color: #e8f0f8;">
            <strong style="color:#00d4aa;">2026-05-21 11:30 CST</strong>
        </p>
        <div style="margin: 0 0 0.8rem 1rem; font-size: 0.85rem; line-height: 1.8; color: #a0b8c8;">
            <p style="margin: 0.2rem 0;">&#x2705; <strong>ML-KEM-768 (FIPS 203)</strong> &mdash; NIST KAT 全量验证通过</p>
            <p style="margin: 0.2rem 0;">&#x2705; <strong>ML-DSA-44 (FIPS 204)</strong> &mdash; 自洽性 7/7 通过</p>
            <p style="margin: 0.2rem 0;">&#x2705; <strong>ML-KEM-1024 (FIPS 203)</strong> &mdash; NIST KAT 全量验证通过</p>
            <p style="margin: 0.2rem 0;">&#x2705; <strong>2026-05-20 全天</strong> &mdash; ML-KEM-768/1024 验证全部通过</p>
            <p style="margin: 0.2rem 0;">&#x23F3; <strong>第三方安全审计</strong> &mdash; 进行中</p>
