{
  "name": "@fibemate/pqc-kem",
  "version": "0.1.0",
  "description": "ML-KEM-768 (FIPS 203) - post-quantum KEM with optional C native addon.",
  "keywords": [
    "ml-kem",
    "post-quantum",
    "fips-203",
    "kem"
  ],
  "license": "GPL-3.0-only",
  "main": "index.js",
  "files": [
    "index.js",
    "src/"
  ],
  "dependencies": {
    "node-addon-api": "^8.2.2"
  },
  "devDependencies": {
    "node-gyp": "^11.0.0"
  },
  "scripts": {
    "test": "node test/basic.test.js",
    "build:native": "node-gyp rebuild -C native",
    "build:native:release": "node-gyp rebuild -C native --release --msvs-version 2022",
    "test:native": "node ../../scripts/test-native-addon.cjs",
    "ci:build": "npm run build:native:release && npm run test:native",
    "bench:native": "node ../../scripts/mlkem-bench-native.cjs 500"
  }
}
