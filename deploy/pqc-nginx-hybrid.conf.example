# SPDX-License-Identifier: GPL-3.0-only
# =============================================================================
# FIBEMATE 平台层 PQC 封装 — Nginx TLS 混合密钥交换参考模板
#
# ⚠️ 前提条件 (部署前必须验证, 否则 nginx 拒启):
#   1. nginx 链接的 OpenSSL >= 3.5 (原生含 ML-KEM, RFC 9598 X25519MLKEM768)
#      - 验证: nginx -V 2>&1 | grep -o 'built with OpenSSL[^)]*'
#      - 注意: openssl version 显示的是 shell 的 OpenSSL, 不等于 nginx 链接的
#   2. 本服务器当前 OpenSSL 3.0.13 (2026-09-06 实测) → 直接启用会 emerg:
#      SSL_CTX_set1_curves_list() failed: group 'X25519MLKEM768' cannot be set
#   3. 升级路径: 系统 OpenSSL 升 3.5+ 或使用含 PQ 的 nginx 构建 (如 GetPageSpeed)
#
# ⚠️ 安全前缀 '?': OpenSSL 3.3+ 语法, 未知组自动跳过不拒启。
#    但注意: 前缀只防宕机, 不保证 PQ 生效 —— 无 ML-KEM 的构建会静默降级为经典,
#    必须用 openssl s_client -groups X25519MLKEM768 实测确认协商结果。
# =============================================================================

server {
    listen 443 ssl http2;
    server_name fibemate.net;

    ssl_protocols TLSv1.3 TLSv1.2;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # 混合组置前, 经典回退在后 (顺序即优先级)
    # 启用条件: OpenSSL >= 3.5。'?' 前缀使低版本自动跳过 (防 emerg)
    ssl_ecdh_curve ?X25519MLKEM768:X25519:secp256r1:secp384r1;

    # TLS 1.3 密码套件 (OpenSSL 3.5+ 默认已含, 显式列出便于审计)
    ssl_ciphersuites TLS_AES_256_GCM_SHA384:TLS_AES_128_GCM_SHA256:TLS_CHACHA20_POLY1305_SHA256;
    # TLS 1.2 兼容 (老客户端)
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    # 证书链: 当前 RSA/ECDSA (混合 KEX 与证书算法无关, 可共存)
    # ML-DSA-65 证书链就绪后追加 (见 docs/pqc-readiness.md 路径 A 演进)
    ssl_certificate     /etc/letsencrypt/live/fibemate.net/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/fibemate.net/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/fibemate.net/chain.pem;

    # HSTS (混合握手变大, 建议保留)
    add_header Strict-Transport-Security "max-age=31536000" always;

    # ---- 应用反代 (应用层零改动) ----
    root /opt/fibemate-full/www;
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:3002/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # 协商结果透传 (供观测: 客户端是否走了混合组)
        proxy_set_header X-PQC-Negotiated $ssl_curve;
    }

    location /health {
        proxy_pass http://127.0.0.1:3002/health;
    }

    location /ws {
        proxy_pass http://127.0.0.1:3002/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }
}

# =============================================================================
# 验证命令 (部署后):
#   openssl s_client -connect fibemate.net:443 -tls1_3 -groups X25519MLKEM768 -servername fibemate.net 2>&1 | grep -i 'negotiated'
#   期望: Negotiated group: X25519MLKEM768
# 回滚: 恢复 sites-enabled 备份 + nginx -s reload
# =============================================================================
