# FIBEMATE .gitattributes
#
# Encoding convention: all text files MUST be plain UTF-8 (NO BOM).
# Reason: PowerShell on Chinese Windows mis-decodes BOM files as GBK,
#         showing garbled text. Use:
#   - Node.js: fs.writeFileSync(path, content, 'utf8')  -- no BOM
#   - VS Code: "files.encoding": "utf8"                -- no BOM
#   - PowerShell: Set-Content -Encoding UTF8NoBOM      -- no BOM
# Enforcement: scripts/check-bom.cjs (pre-commit + CI)
#
* text=auto eol=lf working-tree-encoding=UTF-8
*.html text eol=lf working-tree-encoding=UTF-8
*.md text eol=lf working-tree-encoding=UTF-8
*.js text eol=lf working-tree-encoding=UTF-8
*.json text eol=lf working-tree-encoding=UTF-8
*.sh text eol=lf working-tree-encoding=UTF-8
*.tcl text eol=lf working-tree-encoding=UTF-8
*.png binary
*.jpg binary
*.wasm binary
*.bit binary

# Timestamped evidence must stay byte-exact. An RFC 3161 token binds a SHA-256 of the
# exact bytes, so EOL normalization on checkout would make openssl ts -verify fail
# against the file the token was issued for. -text disables conversion for
# everything under docs/tsa/ (including the .tsq/.tsr tokens themselves).
docs/tsa/** -text
